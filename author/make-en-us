#!/usr/bin/env perl

# Writes templates/<platform>/en-us/ from templates/<platform>/en/: the same
# pages in American spelling (see t/lib/BI/Test/EnUS.pm for the word list and
# the rule that keeps identifiers as they are).  Run it from the checkout after
# changing an en template; t/en-us.t fails until you do.
#
#   perl author/make-en-us
#
# Files in en-us that no longer have an en template are removed.

use strict;
use warnings;

use FindBin qw($Bin);
use lib "$Bin/../t/lib";

use Carp qw(croak);
use File::Basename qw(dirname);
use File::Find ();
use File::Path qw(make_path);
use File::Spec ();

use BI::Test::EnUS qw(expected_tree target_language);

my $templates = File::Spec->catdir($Bin, '..', 'templates');
my $want      = expected_tree($templates);

my ($written, $same) = (0, 0);
for my $rel (sort keys %{$want}) {
	my $file = File::Spec->catfile($templates, split m{/}, $rel);
	if (-f $file) {
		open(my $in, '<:raw', $file) or croak "Cannot read $file: $!";
		my $have = do { local $/; <$in> };
		close $in;
		if ($have eq $want->{$rel}) {
			$same++;
			next;
		}
	}
	make_path(dirname($file));
	open(my $out, '>:raw', $file) or croak "Cannot write $file: $!";
	print {$out} $want->{$rel};
	close $out or croak "Cannot write $file: $!";
	print "wrote templates/$rel\n";
	$written++;
}

# An en-us page whose en page has gone.
my $removed = 0;
opendir(my $dh, $templates) or croak "Cannot read $templates: $!";
for my $platform (grep { !/\A\./ } readdir $dh) {
	my $dir = File::Spec->catdir($templates, $platform, target_language());
	next unless -d $dir;
	File::Find::find({
		no_chdir => 1,
		wanted   => sub {
			return unless -f $_;
			my $rel = File::Spec->abs2rel($_, $dir);
			$rel =~ s{\\}{/}g;
			$rel = join '/', $platform, target_language(), $rel;
			return if exists $want->{$rel};
			unlink $_ or croak "Cannot remove $_: $!";
			print "removed templates/$rel\n";
			$removed++;
		},
	}, $dir);
}
closedir $dh;

print "$written written, $same unchanged, $removed removed\n";
