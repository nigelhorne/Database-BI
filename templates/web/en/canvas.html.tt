[%- WRAPPER 'web/en/layouts/default.html.tt'
    page_title = title
    back_url   = back_url
    back_label = back_label
-%]
<style>
.canvas-grid {
	display: grid;
	grid-template-columns: repeat(12, 1fr);
	gap: 1rem;
	padding: 1rem 0;
}
.visual-card {
	background: var(--card-bg, #fff);
	border: 1px solid var(--border, #dee2e6);
	border-radius: 6px;
	overflow: hidden;
	display: flex;
	flex-direction: column;
}
.visual-card:not([style]) {
	grid-column: span 6;
}
.visual-card-header {
	display: flex;
	align-items: center;
	justify-content: space-between;
	padding: 0.4rem 0.75rem;
	background: var(--header-bg, #f8f9fa);
	border-bottom: 1px solid var(--border, #dee2e6);
	cursor: grab;
}
.visual-card-header:active { cursor: grabbing; }
.visual-card-title {
	font-weight: 600;
	font-size: 0.9rem;
	white-space: nowrap;
	overflow: hidden;
	text-overflow: ellipsis;
}
.visual-card-body {
	flex: 1;
	overflow: auto;
	padding: 0.5rem;
}
.visual-card-body svg {
	max-width: 100%;
	height: auto;
}
.visual-error {
	color: #dc3545;
	padding: 0.5rem;
	font-size: 0.85rem;
}
.visual-table-wrap {
	overflow: auto;
}
.data-table {
	border-collapse: collapse;
	font-size: 0.8rem;
	width: 100%;
}
.data-table th, .data-table td {
	border: 1px solid var(--border, #dee2e6);
	padding: 0.25rem 0.4rem;
	white-space: nowrap;
}
.data-table th {
	background: var(--header-bg, #f8f9fa);
	font-weight: 600;
}
.canvas-toolbar {
	display: flex;
	align-items: center;
	gap: 0.5rem;
	margin-bottom: 0.75rem;
	flex-wrap: wrap;
}
/* Cross-filter chip */
.cf-chip {
	display: inline-flex;
	align-items: center;
	gap: 0.4rem;
	background: #fff3cd;
	border: 1px solid #ffc107;
	border-radius: 4px;
	padding: 0.2rem 0.6rem;
	font-size: 0.82rem;
	color: #664d03;
}
.cf-chip a {
	color: #664d03;
	text-decoration: none;
	font-weight: 700;
}
.cf-chip a:hover { text-decoration: underline; }
/* Source visual: highlighted border, not filtered */
.visual-card.cf-source {
	border-color: #0d6efd;
	box-shadow: 0 0 0 2px rgba(13,110,253,0.25);
}
.visual-card.cf-source .visual-card-header::after {
	content: 'filter source';
	font-size: 0.7rem;
	color: #0d6efd;
	margin-left: auto;
	padding-left: 0.5rem;
	white-space: nowrap;
}
/* SVG marks become pointer-cursor when cross-filter is possible */
.visual-card[data-cf-col] svg rect,
.visual-card[data-cf-col] svg path,
.visual-card[data-cf-col] svg circle {
	cursor: pointer;
}
</style>

<div class="canvas-toolbar">
	<h2 style="margin:0;flex:1">[% title | html %]</h2>
	[% IF cf_display.length %]
	<div class="cf-chip" id="cf-chip">
		<span>Cross-filter: <strong>[% cf_display | html %]</strong></span>
		<a href="[% cf_clear_url | html %]" title="Clear cross-filter">&times; Clear</a>
	</div>
	[% END %]
	<span style="color:var(--muted,#6c757d);font-size:0.85rem">
		[% visuals.size %] visual[% visuals.size != 1 ? 's' : '' %]
	</span>
</div>

<div class="canvas-grid" id="canvas-grid" data-canvas-id="[% canvas_id | html %]">
[% FOREACH v IN visuals %]
	<div class="visual-card[% v.cf_source ? ' cf-source' : '' %]"
	     id="visual-[% v.id %]"
	     data-visual="[% v.id %]"
	     [% IF v.cf_col %]data-cf-col="[% v.cf_col | html %]"[% END %]
	     [% IF v.style %]style="[% v.style | html %]"[% END %]
	     draggable="true">
		<div class="visual-card-header">
			<span class="visual-card-title">[% v.title | html %]</span>
			<span style="font-size:0.75rem;opacity:0.5;margin-left:0.5rem">[% v.kind | html %]</span>
		</div>
		<div class="visual-card-body">
		[% IF v.error %]
			<div class="visual-error">[% v.error | html %]</div>
		[% ELSE %]
			[% v.html %]
		[% END %]
		</div>
	</div>
[% END %]
</div>

<script src="https://cdnjs.cloudflare.com/ajax/libs/d3/7.9.0/d3.min.js"></script>
<script>
(function () {
	'use strict';

	/* ---- drag-to-reorder ---- */
	var grid    = document.getElementById('canvas-grid');
	var anaId   = grid ? grid.getAttribute('data-canvas-id') : '';
	var dragSrc = null;

	function onDragStart(e) {
		dragSrc = this.closest('.visual-card');
		e.dataTransfer.effectAllowed = 'move';
		e.dataTransfer.setData('text/plain', dragSrc.getAttribute('data-visual'));
	}

	function onDragOver(e) {
		e.preventDefault();
		e.dataTransfer.dropEffect = 'move';
	}

	function onDrop(e) {
		e.preventDefault();
		if (!dragSrc) return;
		var target = e.target.closest('.visual-card');
		if (!target || target === dragSrc) return;
		var parent = grid;
		var cards  = Array.from(parent.children);
		var srcIdx = cards.indexOf(dragSrc);
		var tgtIdx = cards.indexOf(target);
		if (srcIdx < 0 || tgtIdx < 0) return;
		if (srcIdx < tgtIdx) {
			parent.insertBefore(dragSrc, target.nextSibling);
		} else {
			parent.insertBefore(dragSrc, target);
		}
		saveLayout();
	}

	function saveLayout() {
		if (!anaId) return;
		var cards  = Array.from(grid.children);
		var layout = cards.map(function (c, i) {
			var vid = parseInt(c.getAttribute('data-visual'), 10);
			var sty = c.getAttribute('style') || '';
			var x = 1, y = i + 1, w = 6, h = 1;
			var mCol = sty.match(/grid-column\s*:\s*(\d+)\/span\s+(\d+)/);
			var mRow = sty.match(/grid-row\s*:\s*(\d+)\/span\s+(\d+)/);
			if (mCol) { x = parseInt(mCol[1], 10); w = parseInt(mCol[2], 10); }
			if (mRow) { y = parseInt(mRow[1], 10); h = parseInt(mRow[2], 10); }
			return { visual: vid, x: x, y: y, w: w, h: h };
		});
		var body = JSON.stringify({ layout: layout });
		fetch('/api/analyses/' + encodeURIComponent(anaId), {
			method  : 'PATCH',
			headers : { 'Content-Type': 'application/json' },
			body    : body,
		}).catch(function () {});
	}

	if (grid) {
		var headers = grid.querySelectorAll('.visual-card-header');
		headers.forEach(function (h) {
			h.addEventListener('dragstart', onDragStart);
		});
		grid.addEventListener('dragover', onDragOver);
		grid.addEventListener('drop',     onDrop);
	}

	/* ---- cross-filter (3.3 URL-stage) ----
	 *
	 * Semantics: self-highlighting.
	 *   - Clicking a mark on visual N navigates to ?cf=col:eq:val&cv=N.
	 *   - On reload the server filters every visual except the source (cv=N).
	 *   - The source card gets a blue border (.cf-source) to show it is the
	 *     filter origin and is intentionally shown unfiltered.
	 *   - Multi-select not supported: each click replaces any prior cross-filter.
	 *   - Cross-filter respects each visual's own saved filters because the
	 *     server applies ?cf= on top of them (see canvas_render in Dashboard.pm).
	 *
	 * extractCfValue(d) extracts the categorical value from a D3 datum.
	 * HTML::D3 uses these shapes depending on chart kind:
	 *   bar/treemap : d = [label, value]   (positional array)
	 *   pie         : d = { data:[label,value], ... }  (pie arc datum)
	 *   stacked     : d = { cat, seg, val }
	 *   combo/line  : d = { x, bar_val, line_val } or { label, value }
	 *   scatter     : d = [x, y]  -- less useful for CF; skipped when val==NaN
	 */
	function extractCfValue(d) {
		if (d === undefined || d === null) return null;
		if (Array.isArray(d) && d.length >= 1) {
			var v = d[0];
			return (v !== null && v !== undefined) ? String(v) : null;
		}
		if (d.data) {
			if (Array.isArray(d.data) && d.data.length >= 1) return String(d.data[0]);
			if (d.data.label !== undefined)                   return String(d.data.label);
		}
		if (d.cat   !== undefined) return String(d.cat);
		if (d.label !== undefined) return String(d.label);
		if (d.x     !== undefined) return String(d.x);
		return null;
	}

	function initCrossFilters() {
		if (typeof d3 === 'undefined') return;
		var cards = document.querySelectorAll('.visual-card[data-cf-col]');
		cards.forEach(function (card) {
			var cfCol = card.getAttribute('data-cf-col');
			var visId = card.getAttribute('data-visual');
			if (!cfCol || visId === null) return;
			var svg = card.querySelector('svg');
			if (!svg) return;
			d3.select(svg)
				.selectAll('rect, path.arc, path.slice, circle.dot, g.bar > rect')
				.on('click.cf', function (event, d) {
					event.stopPropagation();
					var val = extractCfValue(d);
					if (val === null || val === '') return;
					var u = new URL(window.location.href);
					u.searchParams.delete('cf');
					u.searchParams.delete('cv');
					u.searchParams.append('cf', cfCol + ':eq:' + encodeURIComponent(val));
					u.searchParams.set('cv', visId);
					window.location.href = u.toString();
				});
		});
	}

	/* Run after a short delay so D3 chart init (which is synchronous but
	 * may queue microtasks) has fully bound data to the SVG elements. */
	setTimeout(initCrossFilters, 50);

}());
</script>
[%- END -%]
