[%- WRAPPER 'web/en/layouts/default.html.tt' -%]

<style>
  #treemap { overflow: visible; }
  .treemap-container { padding-left: 1rem; }
  .chart-source {
    margin: 0.25rem 0 0;
    font-size: 0.82rem;
    color: #666;
    word-break: break-all;
  }
  .chart-source a { color: inherit; }
  .tm-cell-g { cursor: pointer; }
</style>

<p class="back-link"><a href="/">&larr; Home</a> &rsaquo; <a href="[% back_url | html %]">[% back_label || 'Back' | html %]</a>[%- IF back2_url -%] &rsaquo; <a href="[% back2_url | html %]">[% back2_label || 'Back' | html %]</a>[%- END -%]</p>

<h2 class="graph-title">[% title | html %]</h2>

<div class="graph-export-bar">
  <button class="btn-graph-export" onclick="biTreemapExportSVG()">Export SVG</button>
  <button class="btn-graph-export" onclick="biTreemapExportPNG()">Export PNG</button>
  <span class="graph-point-count">[% tile_count %] tile[% IF tile_count != 1 %]s[% END %]</span>
</div>

<div class="treemap-container">
  <script src="https://d3js.org/d3.v7.min.js"></script>
  [% chart_html %]
</div>

<!-- Metadata read by the drill-down click handler below. -->
<div id="treemap-meta" data-back-url="[% drill_back_url | html %]" data-cat-col="[% cat_col | html %]" hidden></div>

<script>
// Fix tooltip position: HTML::D3 uses event.offsetX/Y (rect-relative) but the
// tooltip div is position:absolute in page coordinates.  Switch it to
// position:fixed and override with clientX/Y via a bubbling SVG listener that
// runs after D3's rect-level handler.
(function () {
  var tip = document.getElementById('treemap_tip');
  if (!tip) return;
  tip.style.position = 'fixed';
  var svg = document.getElementById('treemap');
  if (!svg) return;
  svg.addEventListener('mousemove', function (e) {
    if (tip.style.display === 'none') return;
    tip.style.left = (e.clientX + 12) + 'px';
    tip.style.top  = (e.clientY - 28) + 'px';
  });

  // HTML::D3 truncates labels with U+2026 (ellipsis) but that module lacks
  // 'use utf8', so Perl embeds the raw UTF-8 bytes as Latin-1 chars which
  // the browser renders as mojibake (typically the sequence a-with-circumflex
  // followed by a broken-bar/pipe).  Replace any trailing non-ASCII chars
  // on each label with three plain ASCII dots.
  document.querySelectorAll('#treemap .tm-label').forEach(function (el) {
    var t = el.textContent;
    if (t && /[^\x00-\x7F]/.test(t)) {
      el.textContent = t.replace(/[^\x00-\x7F]+$/, '...');
    }
  });
}());
</script>

<script>
// Clicking a tile filters the source table to that category.
(function () {
  var meta    = document.getElementById('treemap-meta');
  var backUrl = meta ? meta.getAttribute('data-back-url') : '';
  var catCol  = meta ? meta.getAttribute('data-cat-col')  : '';
  if (!backUrl || !catCol) return;

  function drillDown(label) {
    var tmUrl  = window.location.href;
    var sep    = backUrl.indexOf('?') >= 0 ? '&' : '?';
    var target = backUrl + sep + 'f=' + encodeURIComponent(catCol + ':eq:' + label);
    target    += '&back2='       + encodeURIComponent(tmUrl);
    target    += '&back2_label=' + encodeURIComponent('Back to treemap');
    window.location.href = target;
  }

  // D3 binds data synchronously; a brief delay ensures elements are in the DOM.
  setTimeout(function () {
    document.querySelectorAll('#treemap .tm-cell-g').forEach(function (g) {
      var d = g.__data__;
      if (!d || !d.id) return;
      var label = d.id.split('/').pop();
      if (!label) return;
      g.style.cursor = 'pointer';
      g.setAttribute('title', 'Filter table to: ' + label);
      g.addEventListener('click', function () { drillDown(label); });
    });
  }, 50);
}());
</script>

<script>
(function () {
  function biTreemapExportSVG() {
    var svg = document.getElementById('treemap');
    if (!svg) return;
    var src = '<?xml version="1.0" encoding="UTF-8"?>\n'
            + new XMLSerializer().serializeToString(svg);
    var a = document.createElement('a');
    a.href = URL.createObjectURL(new Blob([src], { type: 'image/svg+xml;charset=utf-8' }));
    a.download = 'treemap.svg';
    a.click();
    URL.revokeObjectURL(a.href);
  }
  function biTreemapExportPNG() {
    var svg = document.getElementById('treemap');
    if (!svg) return;
    var w   = parseInt(svg.getAttribute('width'),  10) || 800;
    var h   = parseInt(svg.getAttribute('height'), 10) || 500;
    var canvas = document.createElement('canvas');
    canvas.width = w; canvas.height = h;
    var ctx = canvas.getContext('2d');
    var src = new XMLSerializer().serializeToString(svg);
    var url = URL.createObjectURL(new Blob([src], { type: 'image/svg+xml;charset=utf-8' }));
    var img = new Image();
    img.onload = function () {
      ctx.fillStyle = '#fff';
      ctx.fillRect(0, 0, w, h);
      ctx.drawImage(img, 0, 0);
      URL.revokeObjectURL(url);
      var a = document.createElement('a');
      a.href = canvas.toDataURL('image/png');
      a.download = 'treemap.png';
      a.click();
    };
    img.src = url;
  }
  window.biTreemapExportSVG = biTreemapExportSVG;
  window.biTreemapExportPNG = biTreemapExportPNG;
}());
</script>

[% IF source_url %]
<div id="chart-attribution" data-url="[% source_url | html %]" data-date="[% source_accessed | html %]" hidden></div>
<p class="chart-source">Source: <a href="[% source_url | html %]" rel="noopener noreferrer">[% source_url | html %]</a></p>
<p class="chart-source">Accessed on [% source_accessed %]</p>
[% END %]

[%- END -%]
