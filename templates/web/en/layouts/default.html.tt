<!DOCTYPE html>
<html lang="[% language | html %]">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>[% title | html %] — Database::BI</title>
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    body {
      font-family: system-ui, -apple-system, sans-serif;
      background: #f4f6f9;
      color: #1a1a2e;
      padding: 2rem;
    }

    header {
      margin-bottom: 1.5rem;
    }

    header h1 {
      font-size: 1.75rem;
      font-weight: 600;
      color: #2c3e7a;
    }

    main {
      background: #ffffff;
      border-radius: 8px;
      box-shadow: 0 2px 8px rgba(0,0,0,.08);
      padding: 1.5rem;
      overflow-x: auto;
    }

    table {
      width: 100%;
      border-collapse: collapse;
      font-size: 0.9rem;
    }

    thead tr {
      background: #2c3e7a;
      color: #ffffff;
    }

    thead th {
      padding: 0.75rem 1rem;
      text-align: left;
      font-weight: 600;
      letter-spacing: 0.03em;
      white-space: nowrap;
      cursor: grab;
      user-select: none;
    }

    thead th.dragging {
      opacity: 0.4;
    }

    thead th.drag-over {
      background: #1a2558;
      box-shadow: inset 3px 0 0 #fff;
    }

    thead th[aria-sort]::after {
      content: '';
      display: inline-block;
      width: 0.9em;
      margin-left: 0.35em;
      vertical-align: middle;
      opacity: 0.4;
    }
    thead th[aria-sort="ascending"]::after  { content: '▲'; opacity: 1; }
    thead th[aria-sort="descending"]::after { content: '▼'; opacity: 1; }

    tbody tr:nth-child(even) { background: #f8f9fc; }
    tbody tr:hover           { background: #eef1fb; }

    tbody td {
      padding: 0.6rem 1rem;
      border-bottom: 1px solid #e4e8f0;
    }

    .empty-state {
      text-align: center;
      color: #888;
      padding: 3rem 1rem;
      font-style: italic;
    }

    .error {
      background: #fdecea;
      border-left: 4px solid #c0392b;
      color: #922b21;
      padding: 0.75rem 1rem;
      border-radius: 4px;
      margin-bottom: 1.25rem;
    }

    .back-link {
      margin-bottom: 1rem;
      font-size: 0.875rem;
    }
    .back-link a { color: #2c3e7a; text-decoration: none; }
    .back-link a:hover { text-decoration: underline; }

    /* Toolbar row: record count + "Add database" button */
    .toolbar {
      display: flex;
      align-items: baseline;
      gap: 1rem;
      margin-bottom: 0.75rem;
      flex-wrap: wrap;
    }

    .record-count {
      font-size: 0.8rem;
      color: #666;
      flex: 1;
    }

    /* Chips that summarise active joins */
    .join-chip {
      display: inline-block;
      background: #e8edf8;
      border-radius: 10px;
      padding: 0.15em 0.55em;
      font-size: 0.75rem;
      color: #2c3e7a;
      margin-left: 0.35em;
    }
    .join-chip-key { color: #888; font-size: 0.7rem; }

    /* "Add database" button */
    .btn-add-db {
      flex-shrink: 0;
      padding: 0.3rem 0.9rem;
      border: 1px solid #2c3e7a;
      border-radius: 6px;
      background: transparent;
      color: #2c3e7a;
      font-size: 0.85rem;
      cursor: pointer;
      transition: background 0.15s;
    }
    .btn-add-db:hover:not(:disabled) { background: #eef1fb; }
    .btn-add-db:disabled { opacity: 0.4; cursor: default; }

    /* Join configuration panel */
    .join-panel {
      background: #f0f3fb;
      border: 1px solid #c8d0e8;
      border-radius: 8px;
      padding: 1.25rem;
      margin-bottom: 1rem;
    }

    .join-panel-title {
      font-size: 1rem;
      font-weight: 600;
      color: #2c3e7a;
      margin-bottom: 1rem;
    }

    .join-fields {
      display: grid;
      grid-template-columns: 1fr auto 1fr;
      gap: 0.75rem 1rem;
      align-items: end;
      margin-bottom: 1rem;
    }

    @media (max-width: 680px) {
      .join-fields { grid-template-columns: 1fr; }
      .join-or { display: none; }
    }

    .join-field {
      display: flex;
      flex-direction: column;
      gap: 0.3rem;
    }

    .join-field label {
      font-size: 0.8rem;
      font-weight: 600;
      color: #444;
    }

    .join-field select,
    .join-field input[type="text"] {
      padding: 0.4rem 0.6rem;
      border: 1px solid #c0c8e0;
      border-radius: 5px;
      font-size: 0.875rem;
      background: #fff;
      width: 100%;
    }

    .join-or {
      font-size: 0.8rem;
      color: #888;
      text-align: center;
      padding-bottom: 0.4rem;
    }

    .join-desc {
      font-size: 0.85rem;
      color: #1a3a2a;
      background: #e8f5e9;
      border-left: 3px solid #4caf50;
      padding: 0.6rem 0.9rem;
      border-radius: 4px;
      margin-bottom: 1rem;
    }

    .join-actions {
      display: flex;
      gap: 0.75rem;
      justify-content: flex-end;
    }

    .btn-primary, .btn-secondary {
      padding: 0.4rem 1.1rem;
      border-radius: 6px;
      font-size: 0.875rem;
      cursor: pointer;
      border: 1px solid transparent;
      transition: background 0.15s;
    }
    .btn-primary {
      background: #2c3e7a;
      color: #fff;
      border-color: #2c3e7a;
    }
    .btn-primary:hover:not(:disabled) { background: #1a2558; }
    .btn-primary:disabled { opacity: 0.4; cursor: default; }
    .btn-secondary {
      background: transparent;
      color: #555;
      border-color: #bbb;
    }
    .btn-secondary:hover { background: #eee; }

    /* Database picker */
    .db-list {
      list-style: none;
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
      gap: 1rem;
    }

    .db-card {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 0.4rem;
      padding: 1.25rem 1rem;
      border: 1px solid #dde2f0;
      border-radius: 8px;
      text-decoration: none;
      color: #1a1a2e;
      transition: background 0.15s, box-shadow 0.15s;
    }
    .db-card:hover {
      background: #eef1fb;
      box-shadow: 0 2px 6px rgba(44,62,122,.12);
    }

    .db-icon { font-size: 2rem; }

    .db-name {
      font-weight: 600;
      font-size: 1rem;
      color: #2c3e7a;
    }

    .db-file {
      font-size: 0.75rem;
      color: #888;
    }

    footer {
      margin-top: 1.5rem;
      font-size: 0.75rem;
      color: #999;
      text-align: right;
    }

    /* Section headings (recently opened, etc.) */
    .recent-section {
      margin-top: 2rem;
    }

    .section-heading {
      font-size: 0.8rem;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.06em;
      color: #888;
      margin-bottom: 0.75rem;
    }

    /* Export buttons in the toolbar */
    .export-btns {
      display: flex;
      gap: 0.4rem;
      flex-shrink: 0;
    }

    .btn-export {
      padding: 0.28rem 0.75rem;
      border: 1px solid #5a7a3a;
      border-radius: 6px;
      background: transparent;
      color: #3a5a1a;
      font-size: 0.82rem;
      text-decoration: none;
      white-space: nowrap;
      transition: background 0.12s;
    }
    .btn-export:hover { background: #eef5e8; }

    /* Filter section inside the join panel */
    .filter-section {
      margin-top: 1rem;
      padding-top: 0.9rem;
      border-top: 1px solid #d0d8f0;
    }

    .filter-section-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-bottom: 0.5rem;
    }

    .filter-section-label {
      font-size: 0.78rem;
      font-weight: 600;
      color: #555;
      text-transform: uppercase;
      letter-spacing: 0.05em;
    }

    .btn-add-filter {
      padding: 0.18rem 0.65rem;
      border: 1px dashed #2c3e7a;
      border-radius: 5px;
      background: transparent;
      color: #2c3e7a;
      font-size: 0.8rem;
      cursor: pointer;
    }
    .btn-add-filter:hover { background: #eef1fb; }

    .filter-row {
      display: flex;
      gap: 0.45rem;
      align-items: center;
      margin-bottom: 0.4rem;
      flex-wrap: wrap;
    }

    .filter-col-sel  { min-width: 9rem; }
    .filter-op-sel   { min-width: 8rem; }
    .filter-val-inp  { min-width: 9rem; }

    .filter-row select,
    .filter-row input[type="text"] {
      padding: 0.35rem 0.5rem;
      border: 1px solid #c0c8e0;
      border-radius: 5px;
      font-size: 0.85rem;
      background: #fff;
    }

    .btn-remove-filter {
      background: none;
      border: none;
      color: #aaa;
      cursor: pointer;
      font-size: 1rem;
      line-height: 1;
      padding: 0.2rem 0.4rem;
      border-radius: 3px;
    }
    .btn-remove-filter:hover { background: #fde8e8; color: #c00; }

    /* Filter chips in the toolbar */
    .filter-chips {
      display: inline-flex;
      flex-wrap: wrap;
      gap: 0.3rem;
      align-items: center;
    }

    .filter-chip {
      display: inline-block;
      background: #fff8e1;
      border: 1px solid #f0c040;
      border-radius: 10px;
      padding: 0.1em 0.55em;
      font-size: 0.75rem;
      color: #7a5800;
      font-family: monospace;
    }

    .btn-clear-filters {
      font-size: 0.75rem;
      color: #888;
      text-decoration: none;
      white-space: nowrap;
      flex-shrink: 0;
    }
    .btn-clear-filters:hover { color: #c00; text-decoration: underline; }

    /* "Browse filesystem" button on the home page */
    .browse-link {
      margin-top: 1.5rem;
      text-align: center;
    }

    .btn-browse {
      display: inline-block;
      padding: 0.5rem 1.25rem;
      border: 1px solid #2c3e7a;
      border-radius: 6px;
      color: #2c3e7a;
      text-decoration: none;
      font-size: 0.9rem;
      transition: background 0.15s;
    }
    .btn-browse:hover { background: #eef1fb; }

    /* Filesystem browser */
    .breadcrumb {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 0.2rem;
      margin-bottom: 1rem;
      font-size: 0.85rem;
      color: #555;
      overflow-x: auto;
    }

    .breadcrumb-link {
      color: #2c3e7a;
      text-decoration: none;
      white-space: nowrap;
    }
    .breadcrumb-link:hover { text-decoration: underline; }

    .breadcrumb-sep { color: #999; }

    .breadcrumb-current {
      font-weight: 600;
      color: #1a1a2e;
      white-space: nowrap;
    }

    .browser-list {
      display: flex;
      flex-direction: column;
      gap: 0.25rem;
    }

    .browser-entry {
      display: flex;
      align-items: center;
      gap: 0.6rem;
      padding: 0.55rem 0.75rem;
      border-radius: 6px;
      text-decoration: none;
      color: #1a1a2e;
      transition: background 0.12s;
    }
    .browser-entry:hover { background: #eef1fb; }

    .browser-dir  { color: #2c3e7a; }
    .browser-file { color: #1a3a2a; }

    .browser-icon { font-size: 1.1rem; flex-shrink: 0; }

    .browser-name {
      font-size: 0.9rem;
      word-break: break-all;
    }
  </style>
</head>
<body>
  <header>
    <h1>[% title | html %]</h1>
  </header>
  <main>
    [% content %]
  </main>
  <footer><a href="https://github.com/nigelhorne/Database-BI" target="_blank">Database::BI</a></footer>
</body>
</html>
