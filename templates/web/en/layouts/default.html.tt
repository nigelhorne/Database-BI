<!DOCTYPE html>
<html lang="[% language | html %]">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>[% title | html %] — Database::BI</title>
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    body {
      font-family: system-ui, -apple-system, sans-serif;
      background: #f4f6f9;
      color: #1a1a2e;
      padding: 2rem;
    }

    header {
      margin-bottom: 1.5rem;
    }

    header h1 {
      font-size: 1.75rem;
      font-weight: 600;
      color: #2c3e7a;
    }

    main {
      background: #ffffff;
      border-radius: 8px;
      box-shadow: 0 2px 8px rgba(0,0,0,.08);
      padding: 1.5rem;
      overflow-x: auto;
    }

    table {
      width: 100%;
      border-collapse: collapse;
      font-size: 0.9rem;
    }

    thead tr {
      background: #2c3e7a;
      color: #ffffff;
    }

    thead th {
      padding: 0.75rem 1rem;
      text-align: left;
      font-weight: 600;
      letter-spacing: 0.03em;
      white-space: nowrap;
      cursor: grab;
      user-select: none;
    }

    thead th.dragging {
      opacity: 0.4;
    }

    thead th.drag-over {
      background: #1a2558;
      box-shadow: inset 3px 0 0 #fff;
    }

    tbody tr:nth-child(even) { background: #f8f9fc; }
    tbody tr:hover           { background: #eef1fb; }

    tbody td {
      padding: 0.6rem 1rem;
      border-bottom: 1px solid #e4e8f0;
    }

    .empty-state {
      text-align: center;
      color: #888;
      padding: 3rem 1rem;
      font-style: italic;
    }

    .error {
      background: #fdecea;
      border-left: 4px solid #c0392b;
      color: #922b21;
      padding: 0.75rem 1rem;
      border-radius: 4px;
      margin-bottom: 1.25rem;
    }

    .back-link {
      margin-bottom: 1rem;
      font-size: 0.875rem;
    }
    .back-link a { color: #2c3e7a; text-decoration: none; }
    .back-link a:hover { text-decoration: underline; }

    .record-count {
      font-size: 0.8rem;
      color: #666;
      margin-bottom: 0.75rem;
    }

    /* Database picker */
    .db-list {
      list-style: none;
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
      gap: 1rem;
    }

    .db-card {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 0.4rem;
      padding: 1.25rem 1rem;
      border: 1px solid #dde2f0;
      border-radius: 8px;
      text-decoration: none;
      color: #1a1a2e;
      transition: background 0.15s, box-shadow 0.15s;
    }
    .db-card:hover {
      background: #eef1fb;
      box-shadow: 0 2px 6px rgba(44,62,122,.12);
    }

    .db-icon { font-size: 2rem; }

    .db-name {
      font-weight: 600;
      font-size: 1rem;
      color: #2c3e7a;
    }

    .db-file {
      font-size: 0.75rem;
      color: #888;
    }

    footer {
      margin-top: 1.5rem;
      font-size: 0.75rem;
      color: #999;
      text-align: right;
    }

    /* "Browse filesystem" button on the home page */
    .browse-link {
      margin-top: 1.5rem;
      text-align: center;
    }

    .btn-browse {
      display: inline-block;
      padding: 0.5rem 1.25rem;
      border: 1px solid #2c3e7a;
      border-radius: 6px;
      color: #2c3e7a;
      text-decoration: none;
      font-size: 0.9rem;
      transition: background 0.15s;
    }
    .btn-browse:hover { background: #eef1fb; }

    /* Filesystem browser */
    .breadcrumb {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 0.2rem;
      margin-bottom: 1rem;
      font-size: 0.85rem;
      color: #555;
      overflow-x: auto;
    }

    .breadcrumb-link {
      color: #2c3e7a;
      text-decoration: none;
      white-space: nowrap;
    }
    .breadcrumb-link:hover { text-decoration: underline; }

    .breadcrumb-sep { color: #999; }

    .breadcrumb-current {
      font-weight: 600;
      color: #1a1a2e;
      white-space: nowrap;
    }

    .browser-list {
      display: flex;
      flex-direction: column;
      gap: 0.25rem;
    }

    .browser-entry {
      display: flex;
      align-items: center;
      gap: 0.6rem;
      padding: 0.55rem 0.75rem;
      border-radius: 6px;
      text-decoration: none;
      color: #1a1a2e;
      transition: background 0.12s;
    }
    .browser-entry:hover { background: #eef1fb; }

    .browser-dir  { color: #2c3e7a; }
    .browser-file { color: #1a3a2a; }

    .browser-icon { font-size: 1.1rem; flex-shrink: 0; }

    .browser-name {
      font-size: 0.9rem;
      word-break: break-all;
    }
  </style>
</head>
<body>
  <header>
    <h1>[% title | html %]</h1>
  </header>
  <main>
    [% content %]
  </main>
  <footer>Database::BI</footer>
</body>
</html>
